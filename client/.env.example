# Client env example for Vite
# Copy to .env.local or set in your deployment environment

# Auth0
VITE_AUTH0_DOMAIN=your-auth0-domain
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# API base used by the frontend. In dev you can leave as /api (proxied).
# In production set to the real backend URL, e.g. https://api.myapp.com
VITE_API_BASE=/api

# Dev-only: target for Vite dev server proxy (defaults to http://localhost:5000)
VITE_DEV_BACKEND=http://localhost:5000
